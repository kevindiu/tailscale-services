{
  "TCP": {
    "3443": {
      "HTTPS": true
    },
    "9443": {
      "HTTPS": true
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:3443": {
      "Handlers": {
        "/": {
          "Proxy": "http://127.0.0.1:3000"
        }
      }
    },
    "${TS_CERT_DOMAIN}:9443": {
      "Handlers": {
        "/": {
          "Proxy": "http://127.0.0.1:9119"
        }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:3443": false,
    "${TS_CERT_DOMAIN}:9443": false
  }
}

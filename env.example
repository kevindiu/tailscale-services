# Tailscale Configuration
# Generate an auth key from https://login.tailscale.com/admin/settings/keys
# Recommended: create a reusable, pre-approved key tagged with tag:dns-server
# (Tagged nodes automatically have key expiration disabled, preventing sudden DNS outages)
TS_AUTHKEY=tskey-auth-kXXXXXX-XXXXXXXXXXXXXXXX

# Hostname as it will appear in your Tailscale admin console and MagicDNS
TAILSCALE_HOSTNAME=adguard-tailscale

# Tailscale CLI arguments:
# Default tags this node as tag:dns-server (configure tagOwners in Tailscale ACLs first)
# You can also append subnet routes or exit node flags:
# e.g.: TS_EXTRA_ARGS=--advertise-tags=tag:dns-server --advertise-routes=192.168.1.0/24 --advertise-exit-node
TS_EXTRA_ARGS=--advertise-tags=tag:dns-server

# RustDesk Configuration
# Set this to the Tailscale hostname or Tailscale 100.x.y.z IP of this container
# so that hbbs tells clients where to find hbbr (the relay).
RUSTDESK_RELAY_HOST=adguard-tailscale

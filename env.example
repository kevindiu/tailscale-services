# Tailscale (https://login.tailscale.com/admin/settings/keys — Reusable, Pre-approved)
TS_AUTHKEY=
TAILSCALE_HOSTNAME=tailscale-services
TAILSCALE_UDP_PORT=41642
TS_EXTRA_ARGS=--advertise-exit-node

TZ=Asia/Tokyo

# RustDesk relay hostname or Tailscale IP
RUSTDESK_RELAY_HOST=tailscale-services

# Hermes LLM keys (optional — prefer `docker compose exec -it hermes hermes setup`)
# HERMES_OPENAI_API_KEY=
# HERMES_ANTHROPIC_API_KEY=
# HERMES_OPENROUTER_API_KEY=

# Hermes Dashboard (HTTPS :9443 — password required, e.g. `openssl rand -base64 24`)
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=

# Immich (HTTPS :2443 — use alphanumeric-only passwords, e.g. `openssl rand -hex 24`)
IMMICH_VERSION=release
IMMICH_UPLOAD_LOCATION=./data/immich/library
IMMICH_DB_USER=postgres
IMMICH_DB_NAME=immich
IMMICH_DB_PASSWORD=
IMMICH_REDIS_PASSWORD=

# Rclone Manager (HTTPS :5443 — optional admin seed, min 8-char password; leave unset for Web UI first-run setup)
RCLONE_MANAGER_VERSION=latest
# RCLONE_MANAGER_ADMIN_USER=admin
# RCLONE_MANAGER_ADMIN_PASSWORD=

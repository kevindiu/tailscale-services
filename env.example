# Tailscale Configuration
# Generate an auth key from https://login.tailscale.com/admin/settings/keys
# (Check "Reusable" and "Pre-approved"; no tags required)
TS_AUTHKEY=tskey-auth-kXXXXXX-XXXXXXXXXXXXXXXX

# Hostname as it will appear in your Tailscale admin console and MagicDNS
TAILSCALE_HOSTNAME=tailscale-services

# Tailscale CLI arguments:
# Advertises this container as an Exit Node by default for your Tailnet.
# You can also append subnet routes if desired:
# e.g.: TS_EXTRA_ARGS=--advertise-exit-node --advertise-routes=192.168.1.0/24
TS_EXTRA_ARGS=--advertise-exit-node

# RustDesk Configuration
# Set this to the Tailscale hostname or Tailscale 100.x.y.z IP of this container
# so that hbbs tells clients where to find hbbr (the relay).
RUSTDESK_RELAY_HOST=tailscale-services

# Hermes AI Agent Configuration
# Optional: API keys for your preferred LLM provider.
# If left blank, you can also configure credentials interactively via:
#   docker compose exec -it hermes hermes setup
HERMES_OPENAI_API_KEY=
HERMES_ANTHROPIC_API_KEY=
HERMES_OPENROUTER_API_KEY=

# Antigravity OAuth App Credentials (public client pair for the Antigravity CLI)
ANTIGRAVITY_CLIENT_ID=1071006060591-tmhssin2h21lcre235vtolojh4g403ep.apps.googleusercontent.com
ANTIGRAVITY_CLIENT_SECRET=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

# Hermes Web Dashboard (accessible at http://tailscale-services:9119)
HERMES_DASHBOARD=true
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=admin



